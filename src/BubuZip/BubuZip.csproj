<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>BubuZip</RootNamespace>
    <AssemblyName>BubuZip.UI</AssemblyName>
    <Description>BubuZip shared application UI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../BubuZip.Core/BubuZip.Core.csproj" />
    <ProjectReference Include="../../external/BubuUI/src/BubuUI.Runtime/BubuUI.Runtime.csproj" />
    <ProjectReference Include="../../external/BubuUI/src/BubuUI.Rendering/BubuUI.Rendering.csproj" />
    <ProjectReference Include="../../external/BubuUI/src/BubuUI.Themes.Fluent/BubuUI.Themes.Fluent.csproj" />
    <ProjectReference Include="../../external/BubuUI/src/BubuUI.Compiler.Generator/BubuUI.Compiler.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="**/*.bui;**/*.bss" />
    <EmbeddedResource Include="../../assets/icons/BubuZip.rgba.gz" LogicalName="BubuZip.Icons.Application" />
    <EmbeddedResource Include="../../assets/icons/BubuZip.Archive.rgba.gz" LogicalName="BubuZip.Icons.Archive" />
  </ItemGroup>
</Project>
