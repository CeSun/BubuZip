<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT')">WinExe</OutputType>
    <AssemblyName>BubuZip</AssemblyName>
    <AssemblyTitle>BubuZip</AssemblyTitle>
    <Product>BubuZip</Product>
    <RootNamespace>BubuZip.Desktop</RootNamespace>
    <Description>BubuZip cross-platform desktop application.</Description>
    <ApplicationIcon>../../assets/icons/BubuZip.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <IlcArg Include="--substitution:$(MSBuildThisFileDirectory)NativeAot.Substitutions.xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../assets/icons/BubuZip.Archive.ico" Link="BubuZip.Archive.ico"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="BubuZip.Ui.Tests" />
    <ProjectReference Include="../BubuZip/BubuZip.csproj" />
    <ProjectReference Include="../../external/EclipseUI/src/EclipseUI.Platform.MacOS/EclipseUI.Platform.MacOS.csproj" />
    <ProjectReference Include="../../external/EclipseUI/src/EclipseUI.Platform.Windows/EclipseUI.Platform.Windows.csproj" />
    <ProjectReference Include="../../external/EclipseUI/src/EclipseUI.Platform.Linux/EclipseUI.Platform.Linux.csproj" />
    <ProjectReference Include="../../external/EclipseUI/src/EclipseUI.Rendering.Vello/EclipseUI.Rendering.Vello.csproj" />
    <ProjectReference Include="../../external/EclipseUI/src/EclipseUI.Text.Shaping/EclipseUI.Text.Shaping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../assets/icons/NOTICE.md" Link="licenses/BubuZip/NOTICE.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../assets/icons/NanaZip.License.md" Link="licenses/NanaZip/NanaZip.License.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
